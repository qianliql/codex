<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingVertical="12dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/chooseIcon" style="@style/LedgerOutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="68dp" android:text="选择图标" app:icon="@drawable/ic_other" app:iconSize="28dp" app:iconGravity="textStart" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/nameInput" style="@style/LedgerInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="分类名称" app:endIconMode="clear_text">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/categoryName" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView style="@style/LedgerSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:text="重要度" android:textSize="16sp" android:id="@+id/priorityHeading" />
        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/priorityChoices" android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false" app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/notificationPriority" style="@style/LedgerPriorityButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="通知栏" app:icon="@drawable/ic_wallet" />
            <com.google.android.material.button.MaterialButton android:id="@+id/commonPriority" style="@style/LedgerPriorityButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="常用" app:icon="@drawable/ic_grid" />
            <com.google.android.material.button.MaterialButton android:id="@+id/occasionalPriority" style="@style/LedgerPriorityButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="不常用" app:icon="@drawable/ic_other" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <TextView android:id="@+id/categoryError" style="@style/LedgerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/colorError" android:visibility="gone" />
    </LinearLayout>
</ScrollView>