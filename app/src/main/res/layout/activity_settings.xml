<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?attr/ledgerBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="@dimen/ledger_page_gutter" android:paddingTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
        <com.google.android.material.button.MaterialButton android:id="@+id/goBack" style="@style/LedgerIconButton" android:layout_width="48dp" android:layout_height="48dp" app:icon="@drawable/ic_arrow_left" android:contentDescription="返回我的" />
        <TextView style="@style/LedgerPageTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="设置" />
    </LinearLayout>
    <FrameLayout android:id="@+id/settingsContainer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
