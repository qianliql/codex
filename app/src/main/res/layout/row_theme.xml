<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/LedgerCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/themeName" style="@style/LedgerSectionTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
            <TextView android:id="@+id/selectedLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="已选" android:textColor="?attr/colorPrimary" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/themeCaption" style="@style/LedgerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
            <View android:id="@+id/accentSwatch" android:layout_width="30dp" android:layout_height="30dp" />
            <View android:id="@+id/softSwatch" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="10dp" />
            <View android:id="@+id/backgroundSwatch" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="10dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
