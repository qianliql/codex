<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <TextView android:id="@+id/baseAmount" style="@style/LedgerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="当前金额" />
    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/operations" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:singleSelection="true" app:selectionRequired="true">
        <com.google.android.material.button.MaterialButton android:id="@+id/operationAdd" style="@style/LedgerToggleButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="＋" android:contentDescription="加" />
        <com.google.android.material.button.MaterialButton android:id="@+id/operationSubtract" style="@style/LedgerToggleButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="−" android:contentDescription="减" />
        <com.google.android.material.button.MaterialButton android:id="@+id/operationMultiply" style="@style/LedgerToggleButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="×" android:contentDescription="乘" />
        <com.google.android.material.button.MaterialButton android:id="@+id/operationDivide" style="@style/LedgerToggleButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="÷" android:contentDescription="除" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/operandInput" style="@style/LedgerInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="输入计算数值">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/operand" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:singleLine="true" android:hint="例如 5 或 0.8" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView android:id="@+id/resultPreview" style="@style/LedgerSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="调整后金额" />
</LinearLayout>
