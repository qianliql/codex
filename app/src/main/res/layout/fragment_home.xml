<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:background="?attr/ledgerBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/ledger_page_gutter" android:paddingTop="@dimen/ledger_page_top" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="18dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/LedgerPageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="轻账本"/>
                <TextView android:id="@+id/monthLabel" style="@style/LedgerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/toggleAmounts" style="@style/LedgerTextButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="显示金额" android:padding="0dp" android:minWidth="0dp" app:icon="@drawable/ic_eye" app:iconGravity="textStart" app:iconPadding="0dp" app:iconSize="22dp"/>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_metric">
            <View android:layout_width="4dp" android:layout_height="60dp" android:layout_gravity="top|start" android:layout_marginTop="22dp" android:background="?attr/colorPrimary" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="22dp" android:paddingVertical="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="本月实际支出" android:textColor="?attr/ledgerMuted" android:textSize="14sp" />
                <TextView android:id="@+id/monthExpense" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="¥0.00" android:textColor="?attr/colorOnSurface" android:textSize="40sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="22sp" app:autoSizeMaxTextSize="40sp" app:autoSizeStepGranularity="1sp" />
                <TextView android:id="@+id/monthDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="支出 ¥0.00 · 退款 ¥0.00" android:textColor="?attr/ledgerMuted" android:textSize="12sp" android:lineSpacingExtra="3dp" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="18dp" android:layout_marginBottom="14dp" android:background="?attr/ledgerBorder" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="今日支出" android:textColor="?attr/ledgerMuted" android:textSize="13sp" />
                    <TextView android:id="@+id/todayExpense" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="¥0.00" android:textColor="?attr/colorPrimary" android:textSize="19sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/addTransaction" style="@style/LedgerButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="记一笔" app:icon="@drawable/ic_add" app:iconGravity="textStart"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/viewTransactions" style="@style/LedgerOutlineButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="看账单" app:icon="@drawable/ic_wallet" app:iconGravity="textStart"/>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView android:id="@+id/viewUnconfirmedAmounts" style="@style/LedgerCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/ledgerSoft" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="12dp">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_edit" android:importantForAccessibility="no" app:tint="?attr/colorPrimary" />
                <TextView style="@style/LedgerSectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="待确认金额" android:textSize="15sp" />
                <TextView android:id="@+id/unconfirmedAmountCount" style="@style/LedgerCaption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="…" android:textColor="?attr/colorPrimary" android:layout_marginHorizontal="8dp" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_arrow" android:importantForAccessibility="no" app:tint="?attr/ledgerMuted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:id="@+id/permissionNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_soft" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="开启通知访问，自动记录微信和支付宝支付。" android:textColor="?attr/colorOnSurface" android:textSize="14sp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/openNotificationSettings" style="@style/LedgerTextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="去开启"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/quickNotificationNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_soft" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="开启轻账本通知，直接在通知中分类。" android:textColor="?attr/colorOnSurface" android:textSize="14sp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/openQuickNotificationSettings" style="@style/LedgerTextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="开启快捷分类"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center_vertical">
            <TextView style="@style/LedgerSectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="本月分类"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/viewStatistics" style="@style/LedgerTextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="查看统计" app:icon="@drawable/ic_arrow" app:iconGravity="end" app:iconSize="16dp"/>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView style="@style/LedgerCard" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:id="@+id/categorySummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"/>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center_vertical">
            <TextView style="@style/LedgerSectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="最近账单"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/viewAllTransactions" style="@style/LedgerTextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="全部" app:icon="@drawable/ic_arrow" app:iconGravity="end" app:iconSize="16dp"/>
        </LinearLayout>
        <TextView android:id="@+id/emptyRecent" style="@style/LedgerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_list_row" android:padding="24dp" android:gravity="center" android:text="还没有账单，点“记一笔”开始" android:visibility="gone"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recentList" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false"/>
    </LinearLayout>
</ScrollView>
