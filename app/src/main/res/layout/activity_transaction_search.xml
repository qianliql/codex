<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/ledgerBackground" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingHorizontal="@dimen/ledger_page_gutter" android:paddingTop="8dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/goBack" style="@style/LedgerTextButton" android:layout_width="48dp" android:layout_height="48dp" android:padding="0dp" android:minWidth="0dp" android:contentDescription="返回账单" app:icon="@drawable/ic_arrow_left" app:iconGravity="textStart" app:iconPadding="0dp" />
        <TextView style="@style/LedgerPageTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="搜索账单" />
    </LinearLayout>
    <ScrollView android:id="@+id/searchScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/ledger_page_gutter" android:paddingBottom="16dp">
            <com.google.android.material.card.MaterialCardView style="@style/LedgerCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/typeChoices" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="false">
                        <com.google.android.material.button.MaterialButton style="@style/LedgerToggleButton" android:id="@+id/searchExpenseOption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="支出" />
                        <com.google.android.material.button.MaterialButton style="@style/LedgerToggleButton" android:id="@+id/searchIncomeOption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="收入" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/keywordInput" style="@style/LedgerInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="搜索商户或备注" app:startIconDrawable="@drawable/ic_search" app:endIconMode="clear_text" android:layout_marginTop="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/keyword" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:inputType="text" android:imeOptions="actionSearch" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.card.MaterialCardView style="@style/LedgerCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView style="@style/LedgerSectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:text="分类" android:layout_weight="1" />
                        <com.google.android.material.button.MaterialButton style="@style/LedgerTextButton" android:id="@+id/clearCategory" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp" android:paddingHorizontal="8dp" android:text="全部" android:textSize="13sp" android:contentDescription="清除分类筛选" />
                    </LinearLayout>
                    <HorizontalScrollView android:id="@+id/searchCategoryScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="horizontal" android:scrollbarSize="2dp" android:fadeScrollbars="false" android:overScrollMode="never">
                        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <com.google.android.material.chip.ChipGroup android:id="@+id/categoryChoices" android:layout_width="wrap_content" android:layout_height="wrap_content" app:chipSpacingHorizontal="6dp" app:chipSpacingVertical="6dp" app:singleSelection="true" app:selectionRequired="false" />
                        </FrameLayout>
                    </HorizontalScrollView>
                    <com.google.android.material.button.MaterialButton android:id="@+id/expandSearchCategories" style="@style/LedgerTextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="展开不常用分类 ▾" android:visibility="gone" android:gravity="start|center_vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/LedgerCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView style="@style/LedgerSectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:text="支付方式" android:layout_weight="1" />
                        <com.google.android.material.button.MaterialButton style="@style/LedgerTextButton" android:id="@+id/clearMethod" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp" android:paddingHorizontal="8dp" android:text="全部" android:textSize="13sp" android:contentDescription="清除支付方式筛选" />
                    </LinearLayout>
                    <com.google.android.material.chip.ChipGroup android:id="@+id/methodChoices" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" app:chipSpacingHorizontal="4dp" app:chipSpacingVertical="2dp" app:singleSelection="true" app:selectionRequired="false" app:singleLine="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/LedgerCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView style="@style/LedgerSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="日期范围" />
                    <com.google.android.material.chip.ChipGroup android:id="@+id/datePresets" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:chipSpacingHorizontal="5dp" app:chipSpacingVertical="2dp" app:singleSelection="true" app:selectionRequired="true" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginHorizontal="3dp">
                            <TextView style="@style/LedgerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="开始日期" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/startDate" style="@style/LedgerOutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="不限" android:textSize="13sp" android:paddingHorizontal="8dp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginHorizontal="3dp">
                            <TextView style="@style/LedgerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="结束日期" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/endDate" style="@style/LedgerOutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="不限" android:textSize="13sp" android:paddingHorizontal="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView style="@style/LedgerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="结束日期不能早于开始日期" android:id="@+id/dateError" android:textColor="?attr/colorError" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton android:id="@+id/moreFilters" style="@style/LedgerTextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="更多条件 · 标签、来源、待处理" android:layout_marginTop="8dp" />
            <com.google.android.material.card.MaterialCardView style="@style/LedgerCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:id="@+id/additionalFilters" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <com.google.android.material.textfield.TextInputLayout style="@style/LedgerDropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="标签">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/tagChoice" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:singleLine="true" android:ellipsize="end" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView style="@style/LedgerSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="账单来源" android:layout_marginTop="16dp" />
                    <com.google.android.material.chip.ChipGroup android:id="@+id/sourceChoices" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:chipSpacingHorizontal="5dp" app:chipSpacingVertical="2dp" app:singleSelection="true" app:selectionRequired="true" />
                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/pendingOnly" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="10dp" android:text="只看待处理账单" android:textSize="14sp" android:textColor="?attr/colorOnSurface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="?attr/ledgerBackground" android:paddingHorizontal="@dimen/ledger_page_gutter" android:paddingVertical="6dp">
        <TextView style="@style/LedgerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="不限制条件，查看全部账单" android:id="@+id/conditionCount" android:gravity="center" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton android:id="@+id/resetFilters" style="@style/LedgerOutlineButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="重置" />
            <com.google.android.material.button.MaterialButton android:id="@+id/applyFilters" style="@style/LedgerButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="查看账单" android:enabled="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>