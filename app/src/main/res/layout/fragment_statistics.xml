<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/ledgerBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/ledger_page_gutter">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="14dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/statisticsBack" style="@style/LedgerTextButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="返回首页" android:padding="0dp" android:minWidth="0dp" app:icon="@drawable/ic_arrow_left" app:iconPadding="0dp" app:iconGravity="textStart" app:iconSize="24dp" />
            <TextView style="@style/LedgerPageTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="统计" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/monthMode" style="@style/LedgerButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="月度" />
            <com.google.android.material.button.MaterialButton android:id="@+id/yearMode" style="@style/LedgerOutlineButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="年度" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_marginBottom="12dp" android:gravity="center_vertical" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/previousPeriod" style="@style/LedgerTextButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="上一期" android:padding="0dp" android:minWidth="0dp" app:icon="@drawable/ic_arrow_left" app:iconPadding="0dp" app:iconGravity="textStart" app:iconSize="20dp" />
            <TextView android:id="@+id/periodLabel" android:minHeight="48dp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:contentDescription="选择年份和月份" style="@style/LedgerSectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" />
            <com.google.android.material.button.MaterialButton android:id="@+id/nextPeriod" style="@style/LedgerTextButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="下一期" android:padding="0dp" android:minWidth="0dp" app:icon="@drawable/ic_arrow" app:iconPadding="0dp" app:iconGravity="textStart" app:iconSize="20dp" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView style="@style/LedgerCard" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/LedgerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="总收入" />
                <TextView android:id="@+id/income" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="¥0.00" android:textColor="?attr/colorPrimary" android:textSize="28sp" android:fontFeatureSettings="tnum" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="20sp" app:autoSizeMaxTextSize="28sp" android:maxLines="1" android:textStyle="bold" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="14dp" android:background="?attr/ledgerBorder" />
                <TextView style="@style/LedgerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="实际支出" />
                <TextView android:id="@+id/netExpense" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="¥0.00" android:textColor="?attr/colorOnSurface" android:textSize="34sp" android:fontFeatureSettings="tnum" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="22sp" app:autoSizeMaxTextSize="34sp" android:maxLines="1" android:textStyle="bold" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="14dp" android:background="?attr/ledgerBorder" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/LedgerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="总支出" />
                        <TextView android:id="@+id/expense" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="¥0.00" android:textColor="?attr/colorOnSurface" android:textSize="18sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/LedgerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="退款" />
                        <TextView android:id="@+id/refund" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="¥0.00" android:textColor="?attr/colorPrimary" android:textSize="18sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/averageLabel" style="@style/LedgerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="月均实际支出" android:visibility="gone" />
                <TextView android:id="@+id/average" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="¥0.00" android:textColor="?attr/colorOnSurface" android:textSize="18sp" android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/trendLabel" style="@style/LedgerSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:text="每日实际支出" />
        <com.google.android.material.card.MaterialCardView style="@style/LedgerCard" android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.example.lightledger.ui.SpendingBarChartView android:id="@+id/spendingChart" android:layout_width="match_parent" android:layout_height="190dp" android:layout_margin="12dp" />
        </com.google.android.material.card.MaterialCardView>
        <TextView style="@style/LedgerSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:text="分类收入" />
        <com.google.android.material.card.MaterialCardView style="@style/LedgerCard" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <com.example.lightledger.ui.CategoryDonutView android:id="@+id/incomeDonut" android:layout_width="match_parent" android:layout_height="250dp" />
                <TextView style="@style/LedgerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="点击圆环或分类查看收入明细" />
                <LinearLayout android:id="@+id/incomeLegend" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView style="@style/LedgerSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:text="分类支出" />
        <com.google.android.material.card.MaterialCardView style="@style/LedgerCard" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:id="@+id/categoryContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <com.example.lightledger.ui.CategoryDonutView android:id="@+id/categoryDonut" android:layout_width="match_parent" android:layout_height="250dp" />
                <TextView style="@style/LedgerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="点击圆环或分类查看明细 · 未扣退款" />
                <LinearLayout android:id="@+id/categoryLegend" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView style="@style/LedgerSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:text="支付方式" />
        <com.google.android.material.card.MaterialCardView style="@style/LedgerCard" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:id="@+id/paymentContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
