<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?attr/ledgerBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:paddingTop="8dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/goBack" style="@style/LedgerTextButton" android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="返回" app:icon="@drawable/ic_arrow_left" app:iconPadding="0dp" android:padding="14dp" />
        <TextView style="@style/LedgerSectionTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="主题配色" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/ledger_page_gutter">
            <TextView style="@style/LedgerPageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="给账本换个心情" android:textSize="26sp" />
            <TextView style="@style/LedgerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="选择喜欢的颜色组合，点击即可切换。下次打开会保留你的选择。" />
            <LinearLayout android:id="@+id/themeChoices" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
