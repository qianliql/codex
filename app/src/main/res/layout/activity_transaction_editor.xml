<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/ledgerBackground" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="@dimen/ledger_page_gutter" android:paddingTop="8dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/goBack" style="@style/LedgerTextButton" android:layout_width="48dp" android:layout_height="48dp" android:padding="0dp" android:minWidth="0dp" android:contentDescription="返回" app:icon="@drawable/ic_arrow_left" app:iconGravity="textStart" app:iconPadding="0dp" />
        <TextView android:id="@+id/pageTitle" style="@style/LedgerPageTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="新增账单" />
    </LinearLayout>
    <ScrollView android:id="@+id/editorScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/ledger_page_gutter" android:paddingBottom="12dp">
            <TextView android:id="@+id/ocrWarning" style="@style/LedgerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_soft" android:padding="14dp" android:textColor="?attr/colorOnSurface" android:visibility="gone" />
            <com.google.android.material.card.MaterialCardView style="@style/LedgerCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/typeToggle" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true">
                        <com.google.android.material.button.MaterialButton android:id="@+id/expenseOption" style="@style/LedgerToggleButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="支出" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/incomeOption" style="@style/LedgerToggleButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="收入" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/specialTypeOption" style="@style/LedgerToggleButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:visibility="gone" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <TextView android:id="@+id/amountLabel" style="@style/LedgerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="支出金额（元）" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/amountInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" app:boxBackgroundMode="none" app:hintEnabled="false" app:prefixText="¥" app:prefixTextAppearance="@style/LedgerAmountText" app:prefixTextColor="?attr/colorOnSurface">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="0.00" android:imeOptions="actionNext" android:inputType="numberDecimal" android:maxLines="1" android:textColor="?attr/colorOnSurface" android:textSize="36sp" android:textStyle="bold" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/LedgerCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView style="@style/LedgerSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="选择分类" />
                    <HorizontalScrollView android:id="@+id/categoryScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:scrollbars="horizontal" android:scrollbarSize="2dp" android:fadeScrollbars="false" android:overScrollMode="never">
                        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <com.google.android.material.chip.ChipGroup android:id="@+id/categoryChips" android:layout_width="wrap_content" android:layout_height="wrap_content" app:chipSpacingHorizontal="6dp" app:chipSpacingVertical="6dp" app:singleSelection="true" />
                        </FrameLayout>
                    </HorizontalScrollView>
                    <com.google.android.material.button.MaterialButton android:id="@+id/expandCategories" style="@style/LedgerTextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start|center_vertical" android:text="展开不常用分类 ▾" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/LedgerCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="备注（可选）">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/note" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine" android:minLines="1" android:maxLines="3" android:textSize="15sp" android:paddingVertical="12dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView style="@style/LedgerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="支付方式" />
                    <com.google.android.material.chip.ChipGroup android:id="@+id/paymentMethodChips" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" app:chipSpacingHorizontal="4dp" app:singleLine="true" app:singleSelection="true" app:selectionRequired="true" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/refundLink" style="@style/LedgerOutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="关联原支出（可选）" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/moreDetails" style="@style/LedgerTextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start|center_vertical" android:text="更多 ▾" />
                    <LinearLayout android:id="@+id/additionalDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="商户（可选）">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/merchant" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <CheckBox android:id="@+id/rememberMerchant" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="记住这个商户的分类" android:textColor="?attr/colorOnSurface" android:textSize="14sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/timestamp" style="@style/LedgerOutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/tags" style="@style/LedgerOutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="标签：未选择" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/ocrRawText" style="@style/LedgerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/delete" style="@style/LedgerOutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="删除账单" android:textColor="@color/ledger_orange" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="?attr/ledgerBackground" android:paddingHorizontal="@dimen/ledger_page_gutter" android:paddingVertical="6dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/save" style="@style/LedgerButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:enabled="false" android:text="保存账单" />
    </LinearLayout>
</LinearLayout>
