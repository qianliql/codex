<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The bundled OCR model works locally; remove permissions merged from its transitive SDKs. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <application
        android:name=".LedgerApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="轻账本"
        android:supportsRtl="true"
        android:theme="@style/Theme.LightLedger">
        <service
            android:name=".notification.PaymentNotificationService"
            android:label="轻账本自动记账"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <provider android:name=".notification.ListenerRuntimeProvider" android:authorities="${applicationId}.listener-runtime" android:exported="false" />
        <!-- OCR and UI startup providers must initialize in the process that uses them. -->
        <provider android:name="com.google.mlkit.common.internal.MlKitInitProvider" android:process=":ui" />
        <provider android:name="androidx.startup.InitializationProvider" android:process=":ui" />
        <activity android:name="com.google.android.gms.common.api.GoogleApiActivity" android:process=":ui" />
        <receiver android:name=".notification.QuickCategoryReceiver" android:exported="false" />
        <receiver android:name=".notification.ProtectionNotificationReceiver" android:exported="false" />
        <service android:name=".notification.ListenerRecoveryJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <service android:name=".notification.ListenerProtectionService" android:exported="false" android:stopWithTask="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-enabled persistent status and reconnection for local payment notification bookkeeping while the app is unused; no network or data upload." />
        </service>
        <receiver android:name=".notification.ListenerRestartReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <activity android:process=":ui" android:name=".ui.ThemeActivity" android:exported="false" />
        <activity android:process=":ui" android:name=".ui.ExpenseRankActivity" android:exported="false" />
        <activity android:process=":ui" android:windowSoftInputMode="adjustResize" android:name=".ui.TransactionSearchActivity" android:exported="false" />
        <activity android:process=":ui" android:windowSoftInputMode="adjustResize" android:name=".ui.TransactionEditorActivity" android:exported="false" />
        <activity android:process=":ui" android:windowSoftInputMode="adjustResize" android:name=".ui.ScreenshotImportActivity" android:exported="false" />
        <activity android:process=":ui" android:windowSoftInputMode="adjustResize" android:name=".ui.BatchImportActivity" android:exported="false" />
        <activity android:process=":ui" android:windowSoftInputMode="adjustResize" android:name=".ui.TagsActivity" android:exported="false" />
        <activity android:process=":ui" android:windowSoftInputMode="adjustResize" android:name=".ui.MerchantRulesActivity" android:exported="false" />
        <activity android:process=":ui" android:windowSoftInputMode="adjustResize" android:name=".ui.CategoryActivity" android:exported="false" />
        <activity android:process=":ui" android:windowSoftInputMode="adjustResize" android:name=".ui.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
