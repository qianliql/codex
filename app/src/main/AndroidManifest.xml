<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The bundled OCR model works locally; remove permissions merged from its transitive SDKs. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name=".LedgerApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="轻账本"
        android:supportsRtl="true"
        android:theme="@style/Theme.LightLedger">
        <service
            android:name=".notification.PaymentNotificationService"
            android:label="轻账本自动记账"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <receiver android:name=".notification.QuickCategoryReceiver" android:exported="false" />
        <activity android:name=".ui.ThemeActivity" android:exported="false" />
        <activity android:name=".ui.ExpenseRankActivity" android:exported="false" />
        <activity android:windowSoftInputMode="adjustResize" android:name=".ui.TransactionSearchActivity" android:exported="false" />
        <activity android:windowSoftInputMode="adjustResize" android:name=".ui.TransactionEditorActivity" android:exported="false" />
        <activity android:windowSoftInputMode="adjustResize" android:name=".ui.ScreenshotImportActivity" android:exported="false" />
        <activity android:windowSoftInputMode="adjustResize" android:name=".ui.BatchImportActivity" android:exported="false" />
        <activity android:windowSoftInputMode="adjustResize" android:name=".ui.TagsActivity" android:exported="false" />
        <activity android:windowSoftInputMode="adjustResize" android:name=".ui.MerchantRulesActivity" android:exported="false" />
        <activity android:windowSoftInputMode="adjustResize" android:name=".ui.CategoryActivity" android:exported="false" />
        <activity android:windowSoftInputMode="adjustResize" android:name=".ui.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
